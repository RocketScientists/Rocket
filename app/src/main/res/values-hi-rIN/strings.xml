  <string name="your_rights_content2"><![CDATA["%1$s "<a xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" href="%2$s">%3$s</a>" तथा अन्य ओपन सोर्स लाइसेंस की शर्तों के तहत आपके लिए उपलब्ध कराया जाता है।"]]></string>
  <string name="your_rights_content3"><![CDATA["Mozilla फ़ाउंडेशन या किसी भी पार्टी के ट्रेडमार्क साथ ही %3$s, %4$s या %1$s के नाम अथवा लोगो, के लिए कोई अधिकार या लाइसेंस आपको नहीं दिया जाता है। अधिक जानकारी "<a xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" href="%2$s">&#2351;&#2361;&#2366;&#2305;</a>" से पा सकते हैं।"]]></string>
  <string name="your_rights_content4"><![CDATA["%1$s के लिए अतिरिक्त स्रोत कोड विभिन्न अन्य मुफ़्त और ओपन सोर्स "<a xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" href="%2$s">&#2354;&#2366;&#2351;&#2360;&#2375;&#2306;&#2360;</a>" के तहत उपलब्ध है। "]]></string>
  <string name="your_rights_content5"><![CDATA["%1$s Disconnect, Inc. द्वारा प्रदान की गई ब्लॉकलिस्ट का भी उपयोग करता है जो "<a xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" href="%2$s">&#2332;&#2368;&#2319;&#2344;&#2351;&#2370; &#2360;&#2366;&#2350;&#2366;&#2344;&#2381;&#2351; &#2354;&#2379;&#2325; &#2354;&#2366;&#2351;&#2360;&#2375;&#2306;&#2360; v3</a>" के तहत अलग और स्वतंत्र काम करता है, और "<a xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" href="%3$s">&#2351;&#2361;&#2366;&#2305;</a>" उपलब्ध है।"]]></string>
